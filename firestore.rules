rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isMagneetozOwner() {
      return signedIn() && request.auth.token.email == 'magneetoz73@gmail.com';
    }

    function isKnownPgAdmin() {
      return signedIn() &&
        (request.auth.token.email == 'magneeto73@gmail.com' ||
         request.auth.token.email == 'magneetoz73@gmail.com');
    }

    function isStudentOwner(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isStudentOwner(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /centralMagneetoz/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isMagneetozOwner();
    }

    match /centralMagneetozSites/{siteId} {
      allow read: if true;
      allow write: if isAdmin() || isMagneetozOwner();
    }

    match /centralMagneetozEvents/{eventId} {
      allow create: if true;
      allow read: if isAdmin() || isMagneetozOwner();
      allow update, delete: if isAdmin() || isMagneetozOwner();
    }

    match /pgSites/{siteId} {
      allow read: if true;
      allow write: if isAdmin() || isKnownPgAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
